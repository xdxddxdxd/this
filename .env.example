# AI keys belong only in Supabase Edge Function secrets. Do not add them here.
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Sentry error tracking. Leave empty to disable crash reporting.
VITE_SENTRY_DSN=

# Optional: OCR model override (default: gemini-2.5-flash).
# VITE_GEMINI_OCR_MODEL=gemini-3.5-flash

# Optional: Cerebras (https://cloud.cerebras.ai) — free tier 1M tokens/day.
# Primary analysis tier; same model family as Groq but 10x the daily quota.
# VITE_CEREBRAS_API_KEY=csk-...
# Optional model override: zai-glm-4.7 (default) | gpt-oss-120b
# VITE_CEREBRAS_MODEL=zai-glm-4.7
